{
  "name": "@dingyi222666/dsh-wakatime",
  "version": "0.1.2",
  "description": "WakaTime plugin for DeepSeek Harness (dsh) — track AI coding activity, lines of code, and time spent",
  "author": "dingyi222666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingyi222666/dsh-wakatime.git"
  },
  "homepage": "https://github.com/dingyi222666/dsh-wakatime#readme",
  "bugs": {
    "url": "https://github.com/dingyi222666/dsh-wakatime/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wakatime",
    "time-tracking",
    "ai",
    "coding",
    "productivity"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
